{
    auto_https disable_redirects
    admin off
}

:80 {
    @music_health {
        host musicserver.internal.invalid
        path /health /health/db
    }

    handle @music_health {
        reverse_proxy 10.71.100.83:18080
    }

    @reports {
        host reports.secret-studio.ru
    }

    handle @reports {
        redir https://reports.secret-studio.ru{uri} 308
    }

    handle {
        respond "not found" 404
    }
}

https://reports.secret-studio.ru {
    root * /srv/wg-paid/reports
    file_server
}
