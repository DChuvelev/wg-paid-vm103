}

https://access.secret-studio.ru {
    header {
        Cache-Control "no-store, max-age=0"
        Pragma "no-cache"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    }

    @health path /health
    handle @health {
        respond "access-ok" 200
    }

    @root path /
    handle @root {
        root * /srv/wg-paid/access-web
        rewrite * /index.html
        file_server
    }

    @login path /login /login/
    handle @login {
        root * /srv/wg-paid/access-web
        rewrite * /index.html
        file_server
    }

    @invite path /invite /invite/
    handle @invite {
        root * /srv/wg-paid/access-web
        rewrite * /index.html
        file_server
    }

    @account path /account /account/
    handle @account {
        root * /srv/wg-paid/access-web
        rewrite * /index.html
        file_server
    }

    @magic path /auth/magic /auth/magic/
    handle @magic {
        root * /srv/wg-paid/access-web
        rewrite * /index.html
        file_server
    }

    @assets path /assets/*
    handle @assets {
        root * /srv/wg-paid/access-web
        file_server
    }

    @public_api path /v2/auth/login/request /v2/auth/magic-link/consume /v2/auth/invites/redeem /v2/auth/logout /v2/account/me /v2/account/profiles /v2/account/profiles/*
    handle @public_api {
        reverse_proxy 10.71.100.83:18080
    }

    handle {
        respond "not found" 404
    }
}

https://admin.secret-studio.ru {
    tls /etc/caddy/admin-tls/admin.secret-studio.ru.crt /etc/caddy/admin-tls/admin.secret-studio.ru.key

    header {
        Cache-Control "no-store, max-age=0"
        Pragma "no-cache"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    }

    @trusted_health {
        remote_ip 10.250.100.0/24
        path /health
    }
    handle @trusted_health {
        respond "admin-ok" 200
    }

    @trusted_root {
        remote_ip 10.250.100.0/24
        path /
    }
    handle @trusted_root {
        root * /srv/wg-paid/admin-web
        rewrite * /index.html
        file_server
    }

    @trusted_admin_api {
        remote_ip 10.250.100.0/24
        path /v2/admin/*
    }
    handle @trusted_admin_api {
        reverse_proxy 10.71.100.83:18080
    }

    handle {
        respond "not found" 404
    }
}
